# Next.js app. Copy to .env.local (git-ignored).
# `npx convex dev` writes CONVEX_DEPLOYMENT and the two Convex URLs for you.

CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk dashboard -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The following are Convex deployment variables, not Next.js ones. Set them
# with `npx convex env set NAME value` (or in the Convex dashboard):
#
#   CLERK_JWT_ISSUER_DOMAIN       Clerk "Frontend API URL", e.g. https://xyz.clerk.accounts.dev
#   N8N_LOAN_EVENTS_WEBHOOK_URL   e.g. http://localhost:5678/webhook/lendloop-loan-events
#   LENDLOOP_TO_N8N_SECRET        same value as in .env.n8n
#   N8N_TO_LENDLOOP_SECRET        same value as in .env.n8n
#   APP_URL                       e.g. http://localhost:3000 (used in email links)
#   ALLOW_DEV_SEED                "true" only on a local/dev deployment
