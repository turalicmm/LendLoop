# Copy to .env.n8n (git-ignored) and fill in. Read by docker-compose.yml.

# Encrypts credentials stored in n8n's database. `openssl rand -hex 32`
N8N_ENCRYPTION_KEY=

# Convex -> n8n: verifies the signature on loan events. Must equal the Convex
# env var of the same name.
LENDLOOP_TO_N8N_SECRET=

# n8n -> Convex: signs overdue-loan fetches and write-backs. Must equal the
# Convex env var of the same name. Use a different value from the one above.
N8N_TO_LENDLOOP_SECRET=

# Convex HTTP actions URL. Local backend: http://host.docker.internal:3211
# Cloud: https://<deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

# Used for links in emails.
LENDLOOP_APP_URL=http://localhost:3000

LENDLOOP_MAIL_FROM=LendLoop <hello@lendloop.test>
# Where the error workflow sends failure alerts.
LENDLOOP_OPS_EMAIL=ops@lendloop.test

# SMTP for the "LendLoop SMTP" credential created by n8n/setup.sh.
# Defaults point at the Mailpit container.
LENDLOOP_SMTP_HOST=mailpit
LENDLOOP_SMTP_PORT=1025
LENDLOOP_SMTP_USER=
LENDLOOP_SMTP_PASSWORD=
LENDLOOP_SMTP_SECURE=false
